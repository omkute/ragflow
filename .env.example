# Runtime
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000
API_HOST=127.0.0.1

# PostgreSQL (source of truth)
DATABASE_URL=postgresql://indexa:indexa@localhost:5432/indexa

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Chunking (deterministic token-aware)
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Worker
WORKER_CONCURRENCY=2
