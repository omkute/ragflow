{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@indexa/db": ["packages/db/src/index.ts"],
      "@indexa/db/*": ["packages/db/src/*"],
      "@indexa/document-processing": ["packages/document-processing/src/index.ts"],
      "@indexa/document-processing/*": ["packages/document-processing/src/*"],
      "@indexa/chunking": ["packages/chunking/src/index.ts"],
      "@indexa/chunking/*": ["packages/chunking/src/*"],
      "@indexa/embeddings": ["packages/embeddings/src/index.ts"],
      "@indexa/embeddings/*": ["packages/embeddings/src/*"],
      "@indexa/evaluation": ["packages/evaluation/src/index.ts"],
      "@indexa/evaluation/*": ["packages/evaluation/src/*"],
      "@indexa/llm": ["packages/llm/src/index.ts"],
      "@indexa/llm/*": ["packages/llm/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/drizzle.config.ts",
    "evaluation/scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
